# Die Messwerkzeuge starten Chrome mit einem eigenen Profil und loeschen es
# vor jedem Lauf. Es gehoert nicht ins Repo: hunderte Dateien, die niemand
# liest, und bei jedem Lauf andere.
.chrome-messung/
.chrome-zugang/

__pycache__/

# Kimi-Prüfkreis: der Unterschied für Kimi und die gemerkte Sitzung.
# Die Berichte selbst gehören ins Repo, sie sind die Erfahrung.
berichte/.kimi-*
