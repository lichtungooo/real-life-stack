{
  "name": "@trustdonation/ui",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./dist/src/index.js",
  "module": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/src/index.js"
    },
    "./erweiterungen": {
      "types": "./dist/src/erweiterungen.d.ts",
      "development": "./src/erweiterungen.tsx",
      "import": "./dist/src/erweiterungen.js"
    },
    "./projekt-entwurf": {
      "types": "./dist/src/projekt-entwurf.d.ts",
      "development": "./src/projekt-entwurf.tsx",
      "import": "./dist/src/projekt-entwurf.js"
    },
    "./projekt-profil": {
      "types": "./dist/src/projekt-profil.d.ts",
      "development": "./src/projekt-profil.tsx",
      "import": "./dist/src/projekt-profil.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@real-life-stack/data-interface": "workspace:*",
    "@real-life-stack/toolkit": "workspace:*",
    "@trustdonation/core": "workspace:*"
  },
  "peerDependencies": {
    "lucide-react": "*",
    "react": "^18 || ^19"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "typescript": "~5.7.2",
    "vitest": "^4.1.0"
  }
}
