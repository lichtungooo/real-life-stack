{
  "name": "@kreis/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Kreis: die Flaeche des Space Module. Kreis mit Redestab und Klangschale, Prozess-Leiste, Prozess-Wahl. Spec: docs/spec/modules/kreis.md",
  "license": "MIT",
  "type": "module",
  "main": "./dist/src/index.js",
  "module": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/src/index.js"
    },
    "./flaechen": {
      "types": "./dist/src/flaechen.d.ts",
      "development": "./src/flaechen.ts",
      "import": "./dist/src/flaechen.js"
    },
    "./raum": {
      "types": "./dist/src/raum.d.ts",
      "development": "./src/raum.ts",
      "import": "./dist/src/raum.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@excalidraw/excalidraw": "0.18.1",
    "@kreis/core": "workspace:*",
    "@real-life-stack/toolkit": "workspace:*",
    "pdfjs-dist": "^6.3.289",
    "react-markdown": "^9"
  },
  "peerDependencies": {
    "lucide-react": "*",
    "react": "^18 || ^19",
    "react-router-dom": "^7"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "typescript": "~5.7.2",
    "vitest": "^4.1.0"
  }
}
