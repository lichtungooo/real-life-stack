    "lucide-react": "*",
    "react": "^18 || ^19"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "typescript": "~5.7.2",
    "vitest": "^4.1.0",
    "jsdom": "^26.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@types/react-dom": "^19.0.2",
    "lucide-react": "^0.468.0"
  }
}
